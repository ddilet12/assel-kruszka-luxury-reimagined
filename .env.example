# Shopify Storefront API (public, used by the browser and the checkout server function)
VITE_SHOPIFY_DOMAIN=your-shop.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=

# ApiPay.kz — independent third-party service on top of a merchant's own Kaspi Pay account (NOT an official
# Kaspi integration). With APIPAY_API_KEY set, checkout collects name/phone/address and opens the Kaspi
# payment page; without it, checkout goes to Shopify. https://apipay.kz/for-ai
# API key: ApiPay cabinet > Settings > Подключение (shown once at creation).
APIPAY_API_KEY=
# Set to "false" to switch Kaspi checkout off without removing the key.
APIPAY_ENABLED=
# Webhook secret(s) for /api/webhooks/apipay — comma-separated if several ApiPay keys point at this site.
APIPAY_WEBHOOK_SECRET=
# Public address used for ApiPay's "back to the shop" buttons (defaults to https://asselkruszka.com).
SITE_URL=
